<Window x:Class="WindowsOptimize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsOptimize" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding Visible, Converter={StaticResource BoolVis}}">
                <DockPanel Margin="0,0,10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Chọn / bỏ cả nhóm"
                            Tag="{Binding}" Click="GroupToggle_Click"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemCard}"
                              Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="34,28,24,20"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Sidebar ═══════════════ -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,20,22" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#7B5CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WindowsOptimize" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Label}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,10,18,20">
                    <TextBlock Text="{Binding SystemText}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                    <TextBlock Text="Tạo bởi WindowsOptimize • MIT" Style="{StaticResource Label}" Margin="0,4,0,0" Opacity="0.7"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="PageHome" Checked="Nav_Checked" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Tổng quan"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBloat" Style="{StaticResource Nav}" Tag="PageBloat" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource NavIcon}"/><TextBlock Text="Gỡ app rác"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}" Tag="PageTweaks" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/><TextBlock Text="Riêng tư &amp; tinh chỉnh"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="PageApps" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/><TextBlock Text="Cài ứng dụng"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTools" Style="{StaticResource Nav}" Tag="PageTools" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Công cụ"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRun" Style="{StaticResource Nav}" Tag="PageRun" Checked="Nav_Checked" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" Style="{StaticResource NavIcon}"/><TextBlock Text="Tiến trình"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════ Nội dung ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Tổng quan ─── -->
            <ScrollViewer x:Name="PageHome" Style="{StaticResource Page}" Visibility="Visible">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock Text="Thiết lập Windows mới trong vài phút" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,22"
                               Text="Gỡ app rác, tắt quảng cáo &amp; theo dõi, chặn Windows Update cài lại, rồi cài sẵn app bạn hay dùng. Chọn một bộ bên dưới, xem lại ở các tab bên trái nếu muốn, rồi bấm Bắt đầu."/>

                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <Border Style="{StaticResource Panel}" Margin="0,0,9,0" BorderBrush="{StaticResource AccentSoft}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#FFC75A" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cấu hình của tôi" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,4"
                                           Text="Gỡ sạch app rác (cả OneDrive, Xbox), tắt widget/theo dõi/quảng cáo, dark mode, hiện đuôi file và cài bộ app quen thuộc của bạn."/>
                                <TextBlock Text="{Binding MineSource}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="Chạy ngay  ▶" Tag="mine" Click="RunPreset_Click" IsEnabled="{Binding IsLoaded}"/>
                                    <Button Style="{StaticResource Btn}" Content="Chọn &amp; xem lại" Margin="8,0,0,0" Tag="all:mine" Click="Preset_Click" IsEnabled="{Binding IsLoaded}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="9,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Good}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đề xuất" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,4"
                                           Text="An toàn cho mọi người: gỡ app rác phổ biến, tắt quảng cáo, Copilot, Recall và theo dõi. Giữ OneDrive, Xbox. Cài Chrome, Zalo, UniKey, VLC, 7-Zip, UltraViewer..."/>
                                <TextBlock Text="Phù hợp cài cho người thân, khách hàng" Style="{StaticResource Label}" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnPrimary}" Content="Chạy ngay  ▶" Tag="recommended" Click="RunPreset_Click" IsEnabled="{Binding IsLoaded}"/>
                                    <Button Style="{StaticResource Btn}" Content="Chọn &amp; xem lại" Margin="8,0,0,0" Tag="all:recommended" Click="Preset_Click" IsEnabled="{Binding IsLoaded}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Windows" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemText}"/>
                                <Border Background="{StaticResource WarnSoft}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                        Visibility="{Binding IsLtsc, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="LTSC" FontSize="11" Foreground="{StaticResource Warn}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Bản quyền" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotAct" Style="{StaticResource StatusDot}" Fill="{StaticResource Good}"/>
                                <TextBlock Text="{Binding ActivationText}"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Content="Kích hoạt (MAS)" Padding="12,4" Click="Mas_Click"/>

                            <TextBlock Grid.Row="2" Text="winget" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotWinget" Style="{StaticResource StatusDot}" Fill="{StaticResource Good}"/>
                                <TextBlock Text="{Binding WingetText}"/>
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn}" Content="Cài / sửa winget" Padding="12,4" Click="Winget_Click"/>

                            <TextBlock Grid.Row="3" Text="Microsoft Store" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotStore" Style="{StaticResource StatusDot}" Fill="{StaticResource Good}"/>
                                <TextBlock Text="{Binding StoreText}"/>
                            </StackPanel>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Btn}" Content="Cài Microsoft Store" Padding="12,4" Click="Store_Click"/>

                            <TextBlock Grid.Row="4" Text="Chặn cài lại (Guard)" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotGuard" Style="{StaticResource StatusDot}" Fill="{StaticResource Text3}"/>
                                <TextBlock Text="{Binding GuardText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Gỡ app rác ─── -->
            <ScrollViewer x:Name="PageBloat" Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Text="Gỡ app rác" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding BloatStatus}" Style="{StaticResource Sub}" Margin="0,6,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Style="{StaticResource BtnChip}" Content="★  Của tôi" Tag="bloat:mine" Click="Preset_Click"/>
                        <Button Style="{StaticResource BtnChip}" Content="Đề xuất" Tag="bloat:recommended" Click="Preset_Click"/>
                        <Button Style="{StaticResource BtnChip}" Content="Bỏ chọn hết" Tag="bloat:none" Click="Preset_Click"/>
                    </StackPanel>
                    <Border Background="{StaticResource GoodSoft}" CornerRadius="8" Padding="14,10" Margin="0,0,10,18">
                        <TextBlock TextWrapping="Wrap" Foreground="#BFEBD3">
                            <Run Text="Luôn giữ lại: " FontWeight="SemiBold"/><Run Text="{Binding KeepText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <ItemsControl x:Name="BloatList" ItemsSource="{Binding BloatGroups}" ItemTemplate="{StaticResource GroupTemplate}" Tag="290" SizeChanged="List_SizeChanged"/>
                    <Border Style="{StaticResource Panel}" Margin="0,4,10,0">
                        <TextBlock Style="{StaticResource Sub}">
                            <Run Text="Chặn cài lại: " FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <Run Text="khi bật ô &quot;Chặn cài lại&quot; ở thanh dưới, app đã gỡ được đánh dấu deprovisioned, áp policy gỡ app mặc định (25H2) và có task chạy bằng SYSTEM tự gỡ lại nếu Windows Update/Store lén cài lại. Muốn cài lại 1 app: tick nó ở tab Cài ứng dụng (tự bỏ chặn), hoặc Công cụ → Tắt bảo vệ."/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Tinh chỉnh ─── -->
            <ScrollViewer x:Name="PageTweaks" Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Text="Riêng tư &amp; tinh chỉnh" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,14"
                               Text="Ô có tick = muốn bật. Nhãn &quot;Đang bật&quot; là trạng thái thật trên máy. Bỏ tick 1 ô đang bật để hoàn tác về mặc định của Windows. Di chuột vào ô để xem chính xác khoá registry."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Button Style="{StaticResource BtnChip}" Content="★  Của tôi" Tag="tweak:mine" Click="Preset_Click"/>
                        <Button Style="{StaticResource BtnChip}" Content="Đề xuất" Tag="tweak:recommended" Click="Preset_Click"/>
                        <Button Style="{StaticResource BtnChip}" Content="Giữ nguyên như hiện tại" Tag="tweak:current" Click="Preset_Click"/>
                    </StackPanel>
                    <ItemsControl x:Name="TweakList" ItemsSource="{Binding TweakGroups}" ItemTemplate="{StaticResource GroupTemplate}" Tag="350" SizeChanged="List_SizeChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Cài ứng dụng ─── -->
            <ScrollViewer x:Name="PageApps" Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Text="Cài ứng dụng" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding AppStatus}" Style="{StaticResource Sub}" Margin="0,6,0,14"/>
                    <DockPanel Margin="0,0,10,18">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="240" Style="{StaticResource Search}" TextChanged="Search_TextChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnChip}" Content="★  Của tôi" Tag="app:mine" Click="Preset_Click"/>
                            <Button Style="{StaticResource BtnChip}" Content="Phổ biến" Tag="app:recommended" Click="Preset_Click"/>
                            <Button Style="{StaticResource BtnChip}" Content="Bỏ chọn hết" Tag="app:none" Click="Preset_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="AppList" ItemsSource="{Binding AppGroups}" ItemTemplate="{StaticResource GroupTemplate}" Tag="252" SizeChanged="List_SizeChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Công cụ ─── -->
            <ScrollViewer x:Name="PageTools" Style="{StaticResource Page}">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                    <TextBlock Text="Công cụ" Style="{StaticResource H1}"/>
                    <TextBlock Text="Các việc lẻ, bấm là chạy." Style="{StaticResource Sub}" Margin="0,6,0,18"/>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Panel}" Margin="0,0,9,18">
                            <StackPanel>
                                <TextBlock Text="Kích hoạt Windows &amp; Office" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,12" Text="Mở Microsoft Activation Scripts (massgrave.dev) trong cửa sổ riêng. MAS là script mã nguồn mở của bên thứ ba: bạn tự chọn cách kích hoạt trong menu của nó."/>
                                <Button Style="{StaticResource Btn}" Content="Mở MAS" HorizontalAlignment="Left" Click="Mas_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="9,0,0,18">
                            <StackPanel>
                                <TextBlock Text="winget" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,12" Text="Cài hoặc cập nhật Windows Package Manager từ GitHub chính thức của Microsoft. Tự chạy khi cài app nếu máy thiếu."/>
                                <Button Style="{StaticResource Btn}" Content="Cài / sửa winget" HorizontalAlignment="Left" Click="Winget_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,9,18">
                            <StackPanel>
                                <TextBlock Text="Microsoft Store (cho LTSC)" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,12" Text="Windows LTSC/IoT LTSC không có Store. Cài bằng &quot;wsreset -i&quot; (chính thức), nếu không được thì dùng gói LTSC-Add-MicrosoftStore."/>
                                <Button Style="{StaticResource Btn}" Content="Cài Microsoft Store" HorizontalAlignment="Left" Click="Store_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="9,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Bảo vệ chống cài lại" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,12">
                                    <Run Text="{Binding GuardText, Mode=OneWay}" Foreground="{StaticResource Text}"/><Run Text=". Task chạy bằng SYSTEM khi khởi động, khi đăng nhập, hằng ngày và sau mỗi lần Windows Update."/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" Content="Kiểm tra ngay" Click="GuardRun_Click"/>
                                    <Button Style="{StaticResource Btn}" Content="Tắt &amp; bỏ chặn tất cả" Margin="8,0,0,0" Click="GuardOff_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,9,18">
                            <StackPanel>
                                <TextBlock Text="Bộ &quot;Của tôi&quot;" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,4" Text="Lưu những gì đang tick ở 3 tab thành bộ &quot;Của tôi&quot; (file WindowsOptimize.profile.txt cạnh exe). Copy exe + file này sang máy khác là dùng được ngay."/>
                                <TextBlock Text="{Binding MineSource}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource Btn}" Content="Lưu lựa chọn hiện tại" HorizontalAlignment="Left" Click="SaveMine_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="9,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Khôi phục &amp; nhật ký" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,12" Text="Tạo điểm khôi phục, mở System Restore để quay lại, xem nhật ký, làm mới Explorer."/>
                                <WrapPanel>
                                    <Button Style="{StaticResource Btn}" Content="Tạo điểm khôi phục" Margin="0,0,8,8" Click="RestorePoint_Click"/>
                                    <Button Style="{StaticResource Btn}" Content="Mở System Restore" Margin="0,0,8,8" Click="Rstrui_Click"/>
                                    <Button Style="{StaticResource Btn}" Content="Thư mục nhật ký" Margin="0,0,8,8" Click="Logs_Click"/>
                                    <Button Style="{StaticResource Btn}" Content="Làm mới Explorer" Margin="0,0,8,8" Click="Explorer_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Tiến trình ─── -->
            <Grid x:Name="PageRun" Margin="34,28,28,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RunSummary}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                </StackPanel>
                <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,16,0,16"/>
                <Border Grid.Row="2" Background="#0B0D11" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#B8C2D3"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="12,10" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" CaretBrush="Transparent"/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Style="{StaticResource Btn}" Content="Huỷ sau bước hiện tại" Click="Cancel_Click"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource Btn}" Content="Quay lại" Click="Back_Click" Margin="8,0,0,0"
                            Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="Khởi động lại máy" Click="Reboot_Click" Margin="8,0,0,0"
                            Visibility="{Binding NeedReboot, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Grid>

            <!-- ─── Thanh dưới ─── -->
            <Border x:Name="BottomBar" Grid.Row="1" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Padding="26,10" FontSize="14"
                            IsEnabled="{Binding CanStart}" Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bắt đầu"/>
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,22,0">
                            <Run Text="Gỡ " Foreground="{StaticResource Text2}"/><Run Text="{Binding RemoveCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" app" Foreground="{StaticResource Text2}"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,22,0">
                            <Run Text="Tinh chỉnh " Foreground="{StaticResource Text2}"/><Run Text="{Binding TweakCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" thay đổi" Foreground="{StaticResource Text2}"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,30,0">
                            <Run Text="Cài " Foreground="{StaticResource Text2}"/><Run Text="{Binding InstallCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" app" Foreground="{StaticResource Text2}"/>
                        </TextBlock>
                        <CheckBox Style="{StaticResource Check}" Content="Tạo điểm khôi phục" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Check}" Content="Chặn cài lại" IsChecked="{Binding EnableGuard}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
